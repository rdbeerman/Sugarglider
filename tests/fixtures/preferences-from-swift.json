{
  "animate": false,
  "contextsEnable": true,
  "defaultLayoutKind": "tree",
  "dragDropEnable": true,
  "dragDropLivePreview": false,
  "focusFollowsMouse": true,
  "hotkeys": [
    {
      "category": "System",
      "commandId": "toggle_global_enabled",
      "defaultKey": "⌥Z",
      "description": "Toggle tiling globally",
      "key": "⌥Z"
    },
    {
      "category": "Focus",
      "commandId": "move_focus_left",
      "defaultKey": "⌃⌥⇧←",
      "description": "Focus left",
      "key": "⌃⌥⇧H"
    },
    {
      "category": "Utilities",
      "commandId": "exec",
      "description": "Execute command",
      "key": "⌥T"
    }
  ],
  "innerGap": 4,
  "mouseFollowsFocus": false,
  "outerGap": 8,
  "statusIconEnable": true,
  "windowRules": [
    {
      "appName": "Finder",
      "behavior": "float",
      "bundleId": "com.apple.finder"
    },
    {
      "appName": "Calculator",
      "behavior": "float"
    }
  ]
}
